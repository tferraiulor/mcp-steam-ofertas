# ========================================================
# Configuración del MCP y Bot de Discord: Oferta Steam
# ========================================================

# 1. Token de tu Bot de Discord (Obtenlo gratis en https://discord.com/developers/applications)
# Necesario para conversar con el bot y recibir respuestas en Discord desde el teléfono o PC.
DISCORD_BOT_TOKEN=

# 2. Webhook de Discord para alertas automáticas (opcional)
# Obténlo en Discord: Canal de texto -> Ajustes del canal -> Integraciones -> Webhooks
DISCORD_WEBHOOK_URL=

# 3. Ruta de instalación de Steam (opcional)
# Si lo dejas vacío, el sistema la detecta automáticamente en cualquier PC (Windows Registry, Program Files, Mac, Linux).
# Ejemplo manual: STEAM_DIR=C:\Program Files (x86)\Steam
STEAM_DIR=

# 4. Configuración de Inteligencia Artificial (opcional)
# Por defecto se conecta automáticamente a una IA open-source gratuita sin requerir cuentas ni claves.
# Si prefieres usar otra IA (OpenRouter, OpenAI, Ollama), descomenta y configura:
# AI_API_URL=https://openrouter.ai/api/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=openai/gpt-4o-mini
